# Neon Postgres. Use the pooled connection string for the app and keep
# ?sslmode=require on it.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/civicpulse?sslmode=require"
# Neon's direct (non-pooled) URL. Prisma migrations need this; the pooler
# cannot run DDL.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/civicpulse?sslmode=require"

# better-auth
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# Groq — powers complaint classification. Without it the pipeline falls back
# to keyword matching and flags tickets for human review.
GROQ_API_KEY=""
# Any Groq model with strict JSON-schema support. Defaults to gpt-oss-120b.
GROQ_MODEL="openai/gpt-oss-120b"

# Cloudinary — stores citizen photo evidence. Photos upload straight from the
# browser using a server-generated signature. When these are unset the app runs
# with photos OPTIONAL so it stays usable; set them to make photos mandatory.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Shared secret for POST /api/cron/sla-sweep. The sweep endpoint refuses to
# run without it.
CRON_SECRET="generate with: openssl rand -base64 32"
